#!/bin/sh
set -eu
PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH
base=/usr/local/libexec/dwa121-airport/0.3.4
[ "${3:-}" = / ] && [ "$(id -u)" = 0 ] || exit 1
[ -f "$base/OWNER" ] && [ "$(cat "$base/OWNER")" = DWA121-AIRPORT-P034 ] || exit 1
[ -z "$(find "$base" \( -type l -o ! -user root -o -perm +022 \) -print)" ] || exit 1
echo 'Installed without activation. Open /Applications/DWA121 AirPort Preview.'
